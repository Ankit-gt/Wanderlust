
<% layout("/layout/boilerplate") %>


<body>
 
<div class="all-listings-cont">
    <h3 class="mt-2">  ALL LISTINGS </h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

      <% for (let listings of allListings) { %>

        <a href="/listings/<%= listings.id %>">
    <div class=" col card border-0"  >
      <div class="card-img-overlay">  </div>
         <img  style="height: 18rem;" src="<%= listings.image %>" class="card-img-top" alt="...">
      <div class="card-body">
           <p class="card-text">
           <b> <%= listings.title %></b> <br>
           &#8377; <%= listings.price.toLocaleString("en-IN") %>/night
          </p>
     </div>
    </div>
    </a>
<% } %>
</div>

</div>
</body>

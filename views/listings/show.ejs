<% layout("/layout/boilerplate") %>

<body>
  <div class="card offset-2 border-0 mt-3" style="max-width: 600px">
    <h5 class="card-title">
      <%= listing.title %>
    </h5>
    <img src="<%= listing.image %>" class="card-img-top rounded" style="height: 300px; object-fit: cover" alt="Listing image" />

    <div class="card-body px-0">

      <p class="card-text"> Owned By <b>
          <%= listing.owner.username %>
        </b> </p>
      <p class="card-text">
        <%= listing.description %>
      </p>
      <p class="card-text"> &#8377;
        <%= listing.price.toLocaleString("en-IN") %>
      </p>
      <p class="card-text">
        <%= listing.location %>
      </p>
      <p class="card-text">
        <%= listing.country %>
      </p>
      </p>
    </div>
    <% if (currUser && listing.owner._id.equals(currUser.id)) { %>
    <div class="btns mt-3 d-flex gap-2 mb-5">
      <a class="btn cst-btn" href="/listings/<%= listing._id %>/edit"> EDIT
      </a>

      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn btn-dark">DELETE</button>
      </form>
    </div>





    <% } %>
    <% if (currUser) { %>
    <div class="review-section">
      <h4>Leave a review</h4>

      <form method="post" class="needs-validation" action="/listings/<%= listing._id %>/reviews" novalidate>
        <div>
            <label for="rating" class="form-label"> Rating</label>

          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2
              stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4
              stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>



             </div>
        <div>
          <label class="form-label" for="comment"> Comments </label>
          <textarea required name="review[comment]" id="comments" rows="2" class="form-control"></textarea>

        </div>
        <button class="btn mt-1 cst-btn">Submit</button>
      </form>





      <% } %>
      <hr>
      <h4 class="mt-2">All reviews</h4>
      <div class="row">
        <% for (let review of listing.reviews) { %>
        <div class="card p-2 ms-3 col-5">
          <div class="card-body">
            <h5 class="card-title">
              @
              <%= review.author.username %>
            </h5>

            <p class="starability-result card-text" data-rating="<%= review.rating %>">

            </p>
            <p class="card-text">
              <%= review.comment %>
            </p>

            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-dark">
                Delete Review
              </button>
            </form>
          </div>
        </div>





        <% } %>
      </div>
    </div>
  </div>
</body>
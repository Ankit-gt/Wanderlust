<% layout("/layout/boilerplate") %>

<body>
  <div class="card offset-2 border-0 mt-3" style="max-width: 600px">
    <h5 class="card-title"><%= listing.title %></h5>
    <img
      src="<%= listing.image %>"
      class="card-img-top rounded"
      style="height: 300px; object-fit: cover"
      alt="Listing image"
    />

    <div class="card-body px-0">
      <p class="card-text">
        <%= listing.description %> <br />
        &#8377; <%= listing.price.toLocaleString("en-IN") %><br />
        <%= listing.location %><br />
        <%= listing.country %>
      </p>
    </div>

    <div class="mt-3 d-flex gap-2 mb-5">
      <a class="btn cst-btn" href="/listings/<%= listing._id %>/edit"> EDIT </a>

      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn btn-dark">DELETE</button>
      </form>
    </div>

    <div class="review-section">
      <h4>Leave a review</h4>

      <form method="post" class="needs-validation" action="/listings/<%= listing.id %>/reviews" novalidate>
        <div>
          <label class="form-label" for="rating">Rating</label>
          <input
            type="range"
            min="1"
            max="5"
            id="rating"
            name="review[rating]"
          />
        </div>
        <div>
          <label class="form-label" for="comment"> Comments </label>
          <textarea
          required
            name="review[comment]"
            id="comments"
            rows="2"
            class="form-control"
          ></textarea>

        </div>
        <button class="btn mt-1 cst-btn">Submit</button>
      </form>

<hr>
      <h4 class="mt-2">All reviews</h4>
       <div class="row">
        <% for (let review of listing.reviews) { %>

  <div class="card p-2 ms-3 col-5">
    <div class="card-body">
      <h5 class="card-title">
        John Doe
      </h5>
      <p class="card-text"> <%= review.rating %>&#11088; </p>
      <p class="card-text"><%= review.comment %></p>

      <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
        <button class="btn btn-dark" >
          Delete Review
        </button>
      </form>
    </div>
  </div>

  <%  } %>
     
    </div>
  </div>
  </div>
</body>

<% layout("/layout/boilerplate") %>


  <div class="row offset-2">
    <div class="col-8">
      <form
        action="/listings"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <h3 class="mt-3">Create a New Listing</h3>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            id="title"
            class="form-control"
            name="listing[title]"
            type="text"
            placeholder="Enter title"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter title </div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            id="description"
            class="form-control"
            name="listing[description]"
            placeholder="Add description"
            required
          ></textarea>
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter description</div>
        </div>
        <div class="mb-3">
          <label for="title" class="form-label">Image link</label>
          <input
            id="title"
            class="form-control"
            name="listing[image]"
            type="text"
          />
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              id="price"
              class="form-control"
              type="number"
              name="listing[price]"
              placeholder="Enter price"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Enter price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              id="country"
              class="form-control"
              type="text"
              placeholder="Enter country"
              name="listing[country]"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Enter country</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            id="location"
            class="form-control"
            type="text"
            placeholder="Enter location"
            name="listing[location]"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter location!</div>
        </div>

        <button class="btn btn-dark cst-btn mb-5">Submit</button>
      </form>
    </div>
    <script src="/js/script.js"></script>
  </div>

<% layout("/layout/boilerplate") %>

<body>
  <div class="row">
    <div class="col-8">
      <form
        novalidate
        action="/listings/<%= listing._id %>?_method=PUT"
        class="offset-2 needs-validation"
        method="POST"
      >
        <h3 class="mt-3">Edit Listing</h3>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            value="<%= listing.title %>"
            id="title"
            class="form-control"
            name="listing[title]"
            type="text"
            placeholder="Enter title"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter title!</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            id="description"
            class="form-control"
            name="listing[description]"
            required
          >
 <%= listing.description %></textarea
          >
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter description!</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Image link</label>
          <input
            value="<%= listing.image.url %>"
            id="image"
            class="form-control"
            name="listing[image][url]"
            type="text"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter img url!</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              value="<%= listing.price %>"
              id="price"
              class="form-control"
              type="number"
              name="listing[price]"
              placeholder="Enter price"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Enter price!</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              value="<%= listing.country %>"
              id="country"
              class="form-control"
              type="text"
              placeholder="Enter country"
              name="listing[country]"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Enter country!</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            value="<%= listing.location %>"
            id="location"
            class="form-control"
            type="text"
            placeholder="Enter location"
            name="listing[location]"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter location!</div>
        </div>

        <button class="btn cst-btn mb-5">Edit</button>
      </form>
    </div>
  </div>
  <script src="/js/script.js"></script>
</body>
